OPENAI_API_KEY=your_openai_key
OPENAI_CHAT_MODEL=gpt-4o-mini
# true = use TESTNET keys below, false = use LIVE keys below
EXCHANGE_TESTNET=true

BINANCE_TESTNET_API_KEY=your_key
BINANCE_TESTNET_SECRET=your_secret
BYBIT_TESTNET_API_KEY=your_key
BYBIT_TESTNET_SECRET=your_secret
# Optional Bybit API hostname override (examples: bybit.com, bytick.com)
BYBIT_HOSTNAME=bybit.com
# Optional dedicated Bybit proxy URL (http://user:pass@host:port)
BYBIT_PROXY_URL=
# Price source while in testnet mode: mainnet (recommended) or testnet
BYBIT_TESTNET_PRICE_SOURCE=mainnet
# Cross-exchange outlier filter threshold (percent)
MAX_PRICE_DEVIATION_PCT=8.0
# Exchange request timeout in milliseconds
EXCHANGE_REQUEST_TIMEOUT_MS=12000

# Optional live keys (used when EXCHANGE_TESTNET=false)
BINANCE_API_KEY=your_live_key
BINANCE_SECRET=your_live_secret
BYBIT_API_KEY=your_live_key
BYBIT_SECRET=your_live_secret
COINBASE_API_KEY=your_live_key
COINBASE_SECRET=your_live_secret
COINBASE_PASSPHRASE=your_live_passphrase

JWT_SECRET_KEY=your_custom_secret

# Optional Coinbase testnet keys
COINBASE_TESTNET_API_KEY=
COINBASE_TESTNET_SECRET=
COINBASE_TESTNET_PASSPHRASE=

# Coinbase-only simulated funds mode (keeps live market prices)
COINBASE_PAPER_MODE=true
COINBASE_PAPER_START_USD=10000
COINBASE_PAPER_START_BTC=0
COINBASE_PAPER_AUTO_REBALANCE=true
PAPER_FEE_RATE=0.001
PAPER_SLIPPAGE_RATE=0.0005
# Execution cost model (round-trip estimator used by net-spread guard)
TRADING_FEE_RATE=0.0002
TRADING_SLIPPAGE_RATE=0.00005
ALLOW_NEGATIVE_EST_PROFIT=false
PROFIT_ONLY_EXECUTION=true
MIN_EST_PROFIT_USD=0.0
ENFORCE_AI_SPREAD_GATE=false
ENGINE_LOOP_INTERVAL_SEC=1.0

# Bot execution controls
AUTO_EXECUTION=true
MIN_LIVE_EXCHANGES=2
MAX_EXECUTION_SIZE=0.05
MANUAL_APPROVAL_TIMEOUT_SEC=30
ROUTE_FAIL_COOLDOWN_SEC=20
MAX_ROUTE_STREAK=4
DIVERSIFY_MIN_SPREAD_RATIO=0.85
REQUIRE_POSITIVE_NET=true
MIN_NET_SPREAD=0.0
NO_TRADE_FEEDBACK_INTERVAL_SEC=12
SELL_INVENTORY_BLOCK_SEC=300
RISK_ENABLE_CONSECUTIVE_LOSS_BREAKER=false
RISK_CONSECUTIVE_LOSS_LIMIT=3
RISK_CONSECUTIVE_MIN_LOSS=0.5
RISK_CONSECUTIVE_LOOKBACK_MINUTES=20
RISK_EXCLUDE_PAPER_TRADES=true
